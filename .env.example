VITE_API_BASE_URL=https://WEBSITE/api/v1

# Backend root with no path. Used to derive ALLAUTH_API_URL
# (/_allauth/browser/v1) and OAUTH_BASE_URL (/accounts) in constants.ts.
VITE_BACKEND_URL=https://WEBSITE

# Use one of these keys IF YOU ARE IN DEVELOPMENT, NOT PRODUCTION:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA # Always passes
# VITE_TURNSTILE_SITE_KEY=2x00000000000000000000AB # Always fails
# VITE_TURNSTILE_SITE_KEY=3x00000000000000000000FF # Force interactive challenge