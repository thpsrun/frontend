# API Configuration
# Base URL for the Django backend API
# Development: http://localhost:8001
# Production: https://api.yourdomain.com (or https://yourdomain.com if same domain)
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Backend server root (no path suffix) - used for allauth and OAuth
VITE_BACKEND_URL=http://localhost:8001
